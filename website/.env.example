# Supabase Auth and agency membership (run supabase/migrations first).
# The direct server launch loads website/.env; hosted environment variables are also supported.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PROJECT_PUBLIC_KEY
PUBLIC_SITE_URL=http://localhost:3000
# Generate once: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
AUTH_COOKIE_SECRET=YOUR_64_CHARACTER_HEXADECIMAL_SECRET

# Shared PostgreSQL storage (apply migrations 001 and 002 first).
# Keep these backend-only. Omit DATABASE_URL to retain local JSON development mode.
DATABASE_URL=
# Optional certificate authority file for verified TLS; no URL sslmode options.
DATABASE_CA_FILE=

# Private object storage (apply migrations 003 and 004; backend credentials only).
MEDIA_STORAGE=disk
SUPABASE_SERVICE_ROLE_KEY=

# Existing image-editing backend. No provider is simulated in production.
AI_ENDPOINT=
AI_TOKEN=
# Set to 1 only when AI_ENDPOINT accepts the documented photo + binary PNG mask contract.
AI_SUPPORTS_MASK=0
# Direct image adapters. Credentials stay on the backend; routing is configured in /admin.
OPENAI_API_KEY=
GEMINI_API_KEY=
BFL_API_KEY=
# Optional exact extra BFL delivery hosts, comma-separated; never browser-controlled.
BFL_RESULT_HOSTS=
# Legacy HTTP backend: enable only if it actually accepts reference_image_base64.
AI_SUPPORTS_REFERENCE=0
# Platform-wide administration. In local mode only, ADMIN_TOKEN is accepted if omitted.
PLATFORM_ADMIN_TOKEN=

# Local mode only: omit Supabase variables and configure the existing shared key.
ADMIN_TOKEN=
# Development demonstration is opt-in and always disabled in production.
ENABLE_DEMO=0
PORT=3000
HOST=127.0.0.1
# Recommended for a shared local database without accounts:
# npm run dev:shared creates a private .env, PostgreSQL and connection instructions.
# Do not combine SHARED_WORKSPACE_ID with Supabase auth or production mode.
SHARED_WORKSPACE_ID=
LOCAL_POSTGRES_PORT=54329
